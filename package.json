{
  "name": "az-girls-fashion",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "npm run build -w @az/shared",
    "dev": "concurrently -n api,web \"npm run dev -w @az/api\" \"npm run dev -w @az/web\"",
    "build": "npm run build -w @az/shared && npm run build -w @az/api && npm run build -w @az/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "vitest run",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:init": "npm run init -w @az/api",
    "format": "prettier --write apps packages tests scripts docs *.json *.mjs README.md",
    "api:docs": "node scripts/generate-openapi.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@napi-rs/canvas": "^1.1.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.1",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.10.1",
    "prisma": "6.19.0",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0"
  }
}
